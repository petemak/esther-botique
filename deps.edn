{:paths ["src/backend" "resources"]

 :deps
 {org.clojure/clojure            {:mvn/version "1.12.1"}

  ;; HTTP server + routing (stack mandated by the brief: ring + reitit)
  ring/ring-core                 {:mvn/version "1.14.2"}
  ring/ring-jetty-adapter        {:mvn/version "1.14.2"}
  metosin/reitit                 {:mvn/version "0.7.2"}
  metosin/muuntaja               {:mvn/version "0.6.10"}
  metosin/jsonista               {:mvn/version "0.3.11"}

  ;; Boundary validation
  metosin/malli                  {:mvn/version "0.16.0"}

  ;; CSV parse + generate (A17 product bulk import / export)
  org.clojure/data.csv           {:mvn/version "1.1.1"}

  ;; Persistence
  com.github.seancorfield/next.jdbc {:mvn/version "1.3.955"}
  org.postgresql/postgresql         {:mvn/version "42.7.4"}
  com.zaxxer/HikariCP               {:mvn/version "6.2.1"}
  migratus/migratus                 {:mvn/version "1.5.6"}

  ;; Password hashing
  buddy/buddy-hashers            {:mvn/version "2.0.167"}

  ;; HTTP client for the server-side M-Pesa (Daraja) proxy
  clj-http/clj-http              {:mvn/version "3.13.0"}

  ;; Structured logging
  org.clojure/tools.logging      {:mvn/version "1.3.0"}
  ch.qos.logback/logback-classic {:mvn/version "1.5.6"}}

 :aliases
 {:run
  {:main-opts ["-m" "house-of-esther.main"]}

  :migrate
  {:exec-fn house-of-esther.migrate/-main}

  :seed
  {:exec-fn house-of-esther.seed/-main}

  :test
  {:extra-paths ["test/backend"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts   ["-m" "cognitect.test-runner" "-d" "test/backend"]
   :exec-fn     cognitect.test-runner.api/test
   :exec-args   {:dirs ["test/backend"]}}}}
